# Build-time settings for the frontend. Copy what you need into
# frontend/.env.production.local (gitignored), or set the same names in the
# build environment, which wins over any file.
#
# EVERY VALUE HERE IS PUBLIC. Vite compiles each VITE_* value into the
# JavaScript bundle that any visitor can download, so none of them may ever be
# a password, an API key or anything else secret. Vite reads .env files from
# this folder only; the repo-root .env is never read into the bundle.
#
# A value left empty, or commented out, counts as unset.

# Where the backend is. `npm run build` (production mode) refuses to build
# unless this starts with https://. `npm run dev` and `npm run build:local`
# fall back to http://127.0.0.1:8000 when it is unset.
VITE_API_BASE_URL=

# The organisation responsible for the answers (the Data Fiduciary), as the
# privacy notice should name it. Empty means demo mode: the notices say this is
# a demonstration, name no organisation and ask for made-up figures.
VITE_FIDUCIARY_NAME=

# The organisation's own website, printed as a link on /privacy. Only an
# https:// address is used; anything else is ignored.
VITE_FIDUCIARY_URL=

# How to reach the organisation about the answers: an email address, a phone
# number or a postal address. Printed as plain text on /privacy, never as a
# link. Empty means the notice says no contact has been set.
VITE_PRIVACY_CONTACT=

# The organisation's complaints (grievance) page, printed as a link on
# /privacy. Only an https:// address is used; anything else is ignored.
VITE_GRIEVANCE_URL=

# How many days the organisation keeps the processing records, as a whole
# number from 1 to 99999. This app deletes nothing by itself, so set this only
# to the period the organisation actually deletes records after. Empty means
# the notice says the period has not been set.
VITE_RECORD_RETENTION_DAYS=

# Set to exactly true to ask every reader to confirm their age before the
# answers are sent. Any other value leaves the question out.
VITE_REQUIRE_AGE_CHECK=

# Set to exactly true to offer the voice-and-text helper (/talk), which sends a
# recording or typed text to Meta's models through the backend. The backend must
# be started with ARTHNITI_AI_ENABLED=true and a MODEL_API_KEY as well. Any other
# value leaves the helper out of every page.
VITE_AI_HELPER=
